# Copy to .env and fill in your keys (never commit .env):
#   cp .env.example .env
#
# DSH_HOME must be exported in the shell — do NOT add it to .env (dsh refuses to start).

# Remex HTTP (plugin defaults)
REMEX_BASE_URL=http://localhost:8000
REMEX_TENANT_ID=00000000-0000-4000-8000-000000000001
REMEX_USER_ID=00000000-0000-4000-8000-000000000002

# DeepSeek Harness — agent LLM (official API)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: Laguna via Command Code (OpenAI-compatible gateway)
# LAGUNA_API_KEY=user_your-laguna-key-here
# LAGUNA_BASE_URL=https://api.commandcode.ai/provider/v1
# LAGUNA_MODEL=poolside/laguna-s-2.1-free

# Optional: path to remex-ai checkout (default: sibling ../remex-ai)
# REMEX_AI_DIR=/absolute/path/to/remex-ai
