{
  "name": "@your-scope/remex-dsh-plugin",
  "version": "0.1.0",
  "description": "Cordis MemoryService provider for DeepSeek Harness over Remex HTTP (retrieve pre-step, evaluate post-turn).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./remex-provider": {
      "types": "./lib/remex-provider.d.ts",
      "default": "./lib/remex-provider.js"
    },
    "./context-injector": {
      "types": "./lib/context-injector.d.ts",
      "default": "./lib/context-injector.js"
    },
    "./remember": {
      "types": "./lib/remember.d.ts",
      "default": "./lib/remember.js"
    },
    "./memory-tools": {
      "types": "./lib/memory-tools.d.ts",
      "default": "./lib/memory-tools.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sandbox": "tsc -p tsconfig.json && node --experimental-strip-types sandbox/run-integration.ts",
    "test:dsh": "tsc -p tsconfig.json && node --experimental-strip-types sandbox/run-dsh-integration.ts",
    "setup": "bash scripts/setup-all.sh",
    "setup:fresh": "bash scripts/setup-fresh.sh",
    "setup:credentials": "node --experimental-strip-types sandbox/setup-dsh-credentials.ts",
    "start:web": "bash sandbox/start-dsh-web.sh --no-open",
    "test:browser": "node --experimental-strip-types sandbox/browser-verify.ts",
    "test:browser-headed": "node --experimental-strip-types sandbox/browser-headed-verify.ts"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "remex",
    "memory",
    "cordis"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.8",
    "@types/node": "^22.0.0",
    "playwright": "1.52.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
